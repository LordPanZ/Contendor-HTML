{
  "id": "./",
  "name": "Contenedor HTML",
  "short_name": "HTML Container",
  "description": "Guarda, clasifica, consulta y comparte todos tus archivos HTML desde un único sitio.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0e1014",
  "theme_color": "#0e1014",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "screenshots": [
    {
      "src": "assets/screenshots/escritorio-1280x800.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "La colección en cuadrícula, con miniatura de cada documento"
    },
    {
      "src": "assets/screenshots/movil-412x892.png",
      "sizes": "412x892",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "La colección en el móvil"
    }
  ],
  "shortcuts": [
    {
      "name": "Añadir HTML",
      "short_name": "Añadir",
      "description": "Mete archivos nuevos en el contenedor",
      "url": "./?accion=anadir",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Favoritos",
      "short_name": "Favoritos",
      "description": "Abre los documentos marcados como favoritos",
      "url": "./?accion=favoritos",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
